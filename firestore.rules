rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: Any authenticated user can read; only owner can modify profile (or append to mutual friends list)
    match /profiles/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAuthenticated() && (
        isOwner(userId) || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
      );
      allow delete: if isOwner(userId);
    }
    
    // 2. Study Trackers: Authenticated peers can view progress; only owner can write/update
    match /trackers/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }
    
    // 3. Live Presence & Timers: Authenticated users can see lounge presence; only owner can broadcast their presence
    match /presence/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isOwner(userId);
    }

    // 4. Friend Requests: Only sender or recipient can access and respond
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid || 
        resource.data.toUid == request.auth.uid
      );
      allow delete: if isAuthenticated() && resource.data.fromUid == request.auth.uid;
    }

    // 5. Community Study Lounge Chat: Authenticated users can read and post as themselves
    match /study_lounge_chat/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Default lock down for any undefined document paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
