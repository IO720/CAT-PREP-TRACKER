rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles: Any user can read and update profile
    match /profiles/{userId} {
      allow read, write: if true;
    }
    
    // 2. Study Trackers: Real-time study sync
    match /trackers/{userId} {
      allow read, write: if true;
    }
    
    // 3. Live Presence & Timers: Live online status & active sessions
    match /presence/{userId} {
      allow read, write: if true;
    }

    // 4. Friend Requests: Friend invites & buddy network
    match /friend_requests/{requestId} {
      allow read, write: if true;
    }

    // 5. Public Text Channels Chat
    match /hub_channel_messages_v4/{messageId} {
      allow read, write: if true;
    }

    // 6. Private Study Circle & Direct Messages
    match /private_circle_messages_v4/{messageId} {
      allow read, write: if true;
    }

    // 7. Community Study Lounge Chat
    match /study_lounge_chat/{messageId} {
      allow read, write: if true;
    }

    // Global Fallback for open connectivity across all devices
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
