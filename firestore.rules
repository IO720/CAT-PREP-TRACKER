rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User Profiles: Any user can read/search; authenticated users can create/update
    match /profiles/{userId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isOwner(userId);
    }
    
    // 2. Study Trackers: Peers can view progress; authenticated users can write/update
    match /trackers/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }
    
    // 3. Live Presence & Timers: Anyone can view presence; authenticated users can broadcast
    match /presence/{userId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated();
    }

    // 4. Friend Requests: Authenticated users can create, read, and manage
    match /friend_requests/{requestId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 5. Public Text Channels Chat
    match /hub_channel_messages_v4/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 6. Private Study Circle & Direct Messages
    match /private_circle_messages_v4/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // 7. Community Study Lounge Chat (Legacy fallback)
    match /study_lounge_chat/{messageId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Global Fallback for open connectivity
    match /{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
